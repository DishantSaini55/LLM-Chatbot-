# Copy this file to .env. Do not commit your real provider keys.
# Use two or more comma-separated keys. IDs are assigned in this order:
# first key = key_1, second key = key_2, etc.
LLM_API_KEYS=replace-with-key-one,replace-with-key-two

# Change this to any LiteLLM-supported chat model for your provider.
LLM_MODEL=gemini/gemini-3.1-flash-lite
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
ENABLE_FAILURE_SIMULATION=true
LITELLM_CACHE_TYPE=local
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000

# Used while building the frontend image. In production set this to the public
# backend URL, for example https://your-api.example.com.
VITE_API_BASE_URL=http://localhost:8000
